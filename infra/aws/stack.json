{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "ViaCRM Mumbai EC2, private releases, ECR and GitHub main-branch OIDC deployment",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "SubnetId": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "AmiId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    },
    "InstanceType": {
      "Type": "String",
      "Default": "t3.small",
      "AllowedValues": [
        "t3.small",
        "t3.medium"
      ]
    },
    "GitHubRepository": {
      "Type": "String",
      "Default": "akshayagrg147/ak_test_cm",
      "AllowedPattern": "[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+"
    },
    "GitHubSubjectPrefix": {
      "Type": "String",
      "Default": "repo:akshayagrg147@54131590/ak_test_cm@1437454984",
      "AllowedPattern": "repo:[A-Za-z0-9_.@-]+/[A-Za-z0-9_.@-]+",
      "Description": "Exact sub_claim_prefix from the repository OIDC settings, including immutable IDs when enabled"
    },
    "Domain": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|[A-Za-z0-9][A-Za-z0-9.-]+[A-Za-z0-9]"
    },
    "ComposeVersion": {
      "Type": "String",
      "Default": "v5.6.1",
      "AllowedPattern": "v[0-9]+\\.[0-9]+\\.[0-9]+"
    },
    "CreateGitHubProvider": {
      "Type": "String",
      "Default": "true",
      "AllowedValues": [
        "true",
        "false"
      ]
    }
  },
  "Conditions": {
    "HasDomain": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "Domain"
            },
            ""
          ]
        }
      ]
    },
    "CreateOidc": {
      "Fn::Equals": [
        {
          "Ref": "CreateGitHubProvider"
        },
        "true"
      ]
    }
  },
  "Resources": {
    "ReleaseBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "viacrm-releases-${AWS::AccountId}-${AWS::Region}"
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ReleaseRetention",
              "Status": "Enabled",
              "Prefix": "releases/",
              "ExpirationInDays": 90,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 7
              }
            }
          ]
        }
      }
    },
    "ReleaseBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "ReleaseBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "ReleaseBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${ReleaseBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "HostRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        ],
        "Policies": [
          {
            "PolicyName": "ViaCrmReleaseRead",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchCheckLayerAvailability"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:aws:ecr:${AWS::Region}:${AWS::AccountId}:repository/viacrm/api"
                    },
                    {
                      "Fn::Sub": "arn:aws:ecr:${AWS::Region}:${AWS::AccountId}:repository/viacrm/web"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "${ReleaseBucket.Arn}/releases/*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "HostProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "HostRole"
          }
        ]
      }
    },
    "SecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "ViaCRM public HTTPS; administration through SSM only",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "PublicIp": {
      "Type": "AWS::EC2::EIP",
      "Properties": {
        "Domain": "vpc",
        "Tags": [
          {
            "Key": "Name",
            "Value": "viacrm"
          }
        ]
      }
    },
    "Host": {
      "Type": "AWS::EC2::Instance",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "ImageId": {
          "Ref": "AmiId"
        },
        "InstanceType": {
          "Ref": "InstanceType"
        },
        "SubnetId": {
          "Ref": "SubnetId"
        },
        "IamInstanceProfile": {
          "Ref": "HostProfile"
        },
        "SecurityGroupIds": [
          {
            "Ref": "SecurityGroup"
          }
        ],
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpPutResponseHopLimit": 1
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeType": "gp3",
              "VolumeSize": 30,
              "Encrypted": true,
              "DeleteOnTermination": false
            }
          }
        ],
        "CreditSpecification": {
          "CPUCredits": "standard"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "viacrm"
          },
          {
            "Key": "Project",
            "Value": "viacrm"
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Sub": [
              "#!/bin/bash\nset -euo pipefail\numask 077\ndnf install -y docker python3 tar gzip util-linux\ncommand -v aws\nsystemctl enable --now docker\nmkdir -p /usr/local/lib/docker/cli-plugins /opt/viacrm/bin /opt/viacrm/shared /opt/viacrm/releases /opt/viacrm/backups\ncurl --fail --location --retry 5 https://github.com/docker/compose/releases/download/${ComposeVersion}/docker-compose-linux-x86_64 -o /tmp/docker-compose-linux-x86_64\ncurl --fail --location --retry 5 https://github.com/docker/compose/releases/download/${ComposeVersion}/checksums.txt -o /tmp/compose-checksums.txt\ncd /tmp\ngrep 'docker-compose-linux-x86_64$' /tmp/compose-checksums.txt | sha256sum --check\ninstall -m 755 docker-compose-linux-x86_64 /usr/local/lib/docker/cli-plugins/docker-compose\ncat > /opt/viacrm/shared/host.env <<'ENV'\nAWS_REGION=${AWS::Region}\nECR_REGISTRY=${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com\nRELEASE_BUCKET=${ReleaseBucket}\nPUBLIC_HOST=${HostName}\nENV\ncat > /opt/viacrm/bin/apply-release <<'SCRIPT'\n#!/bin/bash\nset -euo pipefail\numask 077\ncommit=\"$1\"\n[[ \"$commit\" =~ ^[0-9a-f]{40}$ ]] || exit 2\nset -a\nsource /opt/viacrm/shared/host.env\nset +a\ndestination=\"/opt/viacrm/releases/$commit\"\nif [[ ! -f \"$destination/images.env\" ]]; then\n    temporary=\"$(mktemp -d /opt/viacrm/releases/.incoming-XXXXXX)\"\n    trap 'rm -rf \"$temporary\"' EXIT\n    aws s3 cp \"s3://$RELEASE_BUCKET/releases/$commit.tar.gz\" \"$temporary/release.tar.gz\" --only-show-errors\n    mkdir \"$temporary/content\"\n    tar --extract --gzip --file \"$temporary/release.tar.gz\" --directory \"$temporary/content\" --no-same-owner --no-same-permissions\n    mv \"$temporary/content\" \"$destination\"\nfi\nbash \"$destination/deploy.sh\"\nSCRIPT\nchmod 700 /opt/viacrm/bin/apply-release /opt/viacrm/shared /opt/viacrm/releases /opt/viacrm/backups\nchmod 600 /opt/viacrm/shared/host.env\ndocker compose version\ntouch /opt/viacrm/shared/host-ready\n",
              {
                "HostName": {
                  "Fn::If": [
                    "HasDomain",
                    {
                      "Ref": "Domain"
                    },
                    {
                      "Ref": "PublicIp"
                    }
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "IpAssociation": {
      "Type": "AWS::EC2::EIPAssociation",
      "Properties": {
        "InstanceId": {
          "Ref": "Host"
        },
        "AllocationId": {
          "Fn::GetAtt": [
            "PublicIp",
            "AllocationId"
          ]
        }
      }
    },
    "GitHubOidc": {
      "Type": "AWS::IAM::OIDCProvider",
      "Condition": "CreateOidc",
      "Properties": {
        "Url": "https://token.actions.githubusercontent.com",
        "ClientIdList": [
          "sts.amazonaws.com"
        ]
      }
    },
    "DeployRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Fn::If": [
                    "CreateOidc",
                    {
                      "Ref": "GitHubOidc"
                    },
                    {
                      "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:oidc-provider/token.actions.githubusercontent.com"
                    }
                  ]
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": {
                    "Fn::Sub": "${GitHubSubjectPrefix}:ref:refs/heads/main"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ViaCrmDeploy",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ecr:GetAuthorizationToken",
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:CompleteLayerUpload",
                    "ecr:InitiateLayerUpload",
                    "ecr:PutImage",
                    "ecr:UploadLayerPart",
                    "ecr:BatchGetImage",
                    "ecr:GetDownloadUrlForLayer"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:aws:ecr:${AWS::Region}:${AWS::AccountId}:repository/viacrm/api"
                    },
                    {
                      "Fn::Sub": "arn:aws:ecr:${AWS::Region}:${AWS::AccountId}:repository/viacrm/web"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "s3:PutObject",
                  "Resource": {
                    "Fn::Sub": "${ReleaseBucket.Arn}/releases/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": "ssm:SendCommand",
                  "Resource": [
                    {
                      "Fn::Sub": "arn:aws:ssm:${AWS::Region}::document/AWS-RunShellScript"
                    },
                    {
                      "Fn::Sub": "arn:aws:ec2:${AWS::Region}:${AWS::AccountId}:instance/${Host}"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": "ssm:GetCommandInvocation",
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "ApiRepository": {
      "Type": "AWS::ECR::Repository",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "RepositoryName": "viacrm/api",
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        },
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\": [{\"rulePriority\": 1, \"description\": \"Keep 20 release images\", \"selection\": {\"tagStatus\": \"any\", \"countType\": \"imageCountMoreThan\", \"countNumber\": 20}, \"action\": {\"type\": \"expire\"}}]}"
        }
      }
    },
    "WebRepository": {
      "Type": "AWS::ECR::Repository",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "RepositoryName": "viacrm/web",
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        },
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\": [{\"rulePriority\": 1, \"description\": \"Keep 20 release images\", \"selection\": {\"tagStatus\": \"any\", \"countType\": \"imageCountMoreThan\", \"countNumber\": 20}, \"action\": {\"type\": \"expire\"}}]}"
        }
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "Host"
      }
    },
    "PublicIp": {
      "Value": {
        "Ref": "PublicIp"
      }
    },
    "PublicHost": {
      "Value": {
        "Fn::If": [
          "HasDomain",
          {
            "Ref": "Domain"
          },
          {
            "Ref": "PublicIp"
          }
        ]
      }
    },
    "DeployRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "DeployRole",
          "Arn"
        ]
      }
    },
    "ReleaseBucket": {
      "Value": {
        "Ref": "ReleaseBucket"
      }
    },
    "ApiRepository": {
      "Value": {
        "Fn::GetAtt": [
          "ApiRepository",
          "RepositoryUri"
        ]
      }
    },
    "WebRepository": {
      "Value": {
        "Fn::GetAtt": [
          "WebRepository",
          "RepositoryUri"
        ]
      }
    }
  }
}
