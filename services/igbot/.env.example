# Instagram lead bot settings. On the ViaCRM host the real file is
# /opt/viacrm/shared/igbot.env (root, 0600). Never commit real values.
DRY_RUN=1
PORT=8080

# Meta app (developers.facebook.com -> your app)
APP_SECRET=
VERIFY_TOKEN=
IG_ACCESS_TOKEN=
IG_USER_ID=
GRAPH_HOST=graph.facebook.com
GRAPH_VERSION=v27.0

# Claude (understands replies; without it the bot uses keyword rules)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Optional Google Sheet copy (Apps Script web app)
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=

# ViaCRM lead capture (Studio -> Connections -> Lead capture -> Website integration)
VIACRM_CAPTURE_URL=
VIACRM_CAPTURE_TOKEN=
