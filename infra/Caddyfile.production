{
    admin off
    default_sni {$TLS_DEFAULT_SNI}
}
{$PUBLIC_HOST} {$PUBLIC_ALIASES} {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            profile shortlived
        }
    }
    encode zstd gzip
    @alias_page {
        not host {$PUBLIC_HOST}
        not path /api /api/*
    }
    redir @alias_page https://{$PUBLIC_HOST}{uri} 308
    # Instagram webhook for the lead bot; everything else goes to the CRM.
    handle /ig-webhook* {
        request_body {
            max_size 1MB
        }
        reverse_proxy igbot:8080
    }
    handle {
        reverse_proxy web:80
    }
    header Strict-Transport-Security "max-age=31536000"
}
